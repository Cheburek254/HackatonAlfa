server {
    listen 127.0.0.1:8081;
    location = /health {
        return 204;
    }
}

server {
    listen 80;
    return 302 https://${ALFA_HTTPS_HOST}:${ALFA_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${ALFA_HTTPS_HOST};

    ssl_certificate /etc/letsencrypt/live/${ALFA_HTTPS_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ALFA_HTTPS_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8k;
    proxy_set_header Host ${ALFA_HTTPS_HOST}:${ALFA_HTTPS_PORT};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location / {
        proxy_pass http://172.31.249.3:8080;
    }

    location = /profile/settings {
        client_max_body_size 4m;
        proxy_pass http://172.31.249.3:8080;
    }
}
