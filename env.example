APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_PORT=18081
ALFA_SECRET_KEY=
# Каталог на хосте с catalog_slim.json, catalog_slim.sqlite или catalog.norm.json.
ALFA_CATALOG_DIR=
# Ключ Gemini API для ИИ-помощника (Google AI Studio)
ALFA_LLM_API_KEY=
ALFA_LLM_MODEL=gemini-3.5-flash-lite
# Вес BM25 в смешанном режиме. Вес recommend равен 1 минус этот вес.
ALFA_BM25_WEIGHT=0.25
# Резервный провайдер OpenRouter (если Gemini недоступен или заблокирован по гео)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
